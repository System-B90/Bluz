.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# tools.py runtime state
/scripts/.tools/

# typescript
*.tsbuildinfo
next-env.d.ts

*.tar
.vscode/PythonImportHelper-v2-Completion.json
ssl/
# Playwright storage state: real session cookies for each test user. The
# pattern used to name user.json alone, so the second user's state (#606) was
# left untracked-but-committable.
tests/.auth/

# docs
/site/

/scripts/hive-api-6.4.0.yaml
# python
__pycache__/
*.pyc
.claude/worktrees/
# Agent worktrees checked out inside the repo. Each is its own git repo, so a
# `git add -A` otherwise stages it as an embedded repository (gitlink).
/worktrees/

# vim undo files
*.un~
