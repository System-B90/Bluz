FROM node:22-alpine AS deps

WORKDIR /app

# GitHub Packages read token for @system-b15/* (npm resolves ${NPM_TOKEN} from env)
ARG NPM_TOKEN
ENV NPM_TOKEN=${NPM_TOKEN}

COPY package.json package-lock.json .npmrc ./
RUN npm install --ignore-scripts

FROM deps AS builder

WORKDIR /app

COPY tsconfig.json session-server.ts session-common.ts ./
RUN npm run build

FROM node:22-alpine AS prod-deps

WORKDIR /app

ARG NPM_TOKEN
ENV NPM_TOKEN=${NPM_TOKEN}

COPY package.json package-lock.json .npmrc ./
RUN npm install --omit=dev --ignore-scripts && rm -f .npmrc

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist

USER node
EXPOSE 28199

CMD ["node", "dist/session-server.js"]
