FROM nginx:1.29.8-alpine

COPY nginx.conf /etc/nginx/nginx.conf
COPY proxy_params.conf /etc/nginx/proxy_params.conf
# Static TLS snippets; 40-bluz-acme.sh swaps them for nginx's built-in ACME
# client when ACME_DIRECTORY_URL is set (#803).
COPY bluz/ /etc/nginx/bluz/
COPY --chmod=755 40-bluz-acme.sh /docker-entrypoint.d/40-bluz-acme.sh

EXPOSE 80 443
