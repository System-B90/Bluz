events {
    worker_connections 1024;
}

http {
    upstream bluz_frontend {
        server ui:3000;
    }

    upstream bluz_websocket {
        server sessions:28199;
    }

    # Redirect all HTTP traffic to HTTPS
    server {
        listen 80;
        server_name _;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        server_name _;

        # SSL Certificate Paths (Must match volume mounts in docker-compose)
        ssl_certificate /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/key.pem;

        # Standard SSL Hardening
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        # Next.js Frontend Routing
        location / {
            proxy_pass http://bluz_frontend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /_next/webpack-hmr {
            proxy_pass http://bluz_frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # REQUIRED FOR NEXTJS HMR WEBSOCKETS:
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            # Prevent NGINX from closing long-lived, idle connections
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # WebSocket Server Routing
        location /ws/ {
            proxy_pass http://bluz_websocket;
            proxy_http_version 1.1;

            # Required headers to establish and maintain WebSocket connections
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Prevent NGINX from closing long-lived, idle connections
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
