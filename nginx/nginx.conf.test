events {
    worker_connections 1024;
}

http {
    # nginx resolves a name in `upstream` (or a literal proxy_pass) exactly
    # once, at startup, and caches the address forever. The ui container spends
    # its first minutes retrying migrations against a database that is still
    # starting, so the proxy is regularly up first — and once the address it
    # cached stops answering, every request 502s for the rest of the run even
    # though the app is healthy. That is what timed out the readiness probe
    # after 20 minutes with a container reporting (healthy).
    #
    # 127.0.0.11 is Docker's embedded DNS. Resolving through a *variable*
    # forces nginx to look the name up per request and honour the TTL, so the
    # proxy recovers on its own instead of needing a restart.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    # Redirect all HTTP traffic to HTTPS
    server {
        listen 80;
        server_name _;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        server_name _;

        # SSL Certificate Paths (Must match volume mounts in docker-compose)
        ssl_certificate /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/key.pem;

        # Standard SSL Hardening
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        # Next.js Frontend Routing
        location / {
            # $request_uri is required: a variable proxy_pass does not pass the
            # original URI on by itself.
            set $bluz_frontend ui:3000;
            proxy_pass http://$bluz_frontend$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /_next/webpack-hmr {
            set $bluz_hmr ui:3000;
            proxy_pass http://$bluz_hmr$request_uri;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # REQUIRED FOR NEXTJS HMR WEBSOCKETS:
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            # Prevent NGINX from closing long-lived, idle connections
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # WebSocket Server Routing
        location /ws/ {
            set $bluz_websocket sessions:28199;
            proxy_pass http://$bluz_websocket$request_uri;
            proxy_http_version 1.1;

            # Required headers to establish and maintain WebSocket connections
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Prevent NGINX from closing long-lived, idle connections
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
