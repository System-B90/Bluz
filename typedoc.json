{
    "$schema": "https://typedoc.org/schema.json",
    "entryPointStrategy": "expand",
    "entryPoints": [
        "ui/src/api-shared",
        "ui/src/api-server",
        "ui/src/api-client"
    ],
    "tsconfig": "ui/tsconfig.json",
    "out": "docs/api",
    "plugin": ["typedoc-plugin-markdown"],
    "excludePrivate": true,
    "excludeInternal": true,
    "excludeExternals": true,
    "exclude": [
        "**/node_modules/**",
        "**/.next/**",
        "**/*.test.*",
        "**/*.spec.*"
    ],
    "readme": "none",
    "githubPages": false,
    "hideGenerator": true,
    "entryFileName": "index.md"
}
