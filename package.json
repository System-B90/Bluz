{
    "name": "bluz",
    "version": "1.0.0-rc.13",
    "private": true,
    "scripts": {
        "next:dev": "next dev ui --turbopack -H 0.0.0.0",
        "dev": "node -e \"const fs = require('fs'); fs.copyFileSync(fs.existsSync('.env-mks-srvu') ? '.env-mks-srvu' : '.env', 'ui/.env')\" && docker compose --env-file .env -f deploy/docker-compose.local.yml up proxy -d && npm run next:dev",
        "build": "next build ui",
        "start": "next start ui",
        "typecheck": "tsc -p ui/tsconfig.typecheck.json --noEmit",
        "lint": "eslint --config ./ui/eslint.config.mts ui/",
        "lint:fix": "eslint --config ./ui/eslint.config.mts --fix ui/",
        "prepare": "husky",
        "db:generate": "drizzle-kit generate --config=drizzle/drizzle.config.ts",
        "db:push": "drizzle-kit push --config=drizzle/drizzle.config.ts",
        "db:studio": "drizzle-kit studio --config=drizzle/drizzle.config.ts",
        "db:seed": "python scripts/demo/populate_demo_hive.py && npx tsx scripts/demo/populate_demo_bluz.ts && npx tsx scripts/demo/populate_demo_gantt.ts",
        "docker:dev": "docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml up -d && docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml watch ui",
        "docker:prod": "docker compose --env-file .env -f deploy/docker-compose.yml up -d --build",
        "docker:down": "docker compose --env-file .env -f deploy/docker-compose.yml down",
        "docker:nuke": "docker compose --env-file .env -f deploy/docker-compose.yml down -v",
        "docker:test": "docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.test.yml up -d --build",
        "docker:test:down": "docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.test.yml down -v",
        "docker:test:ps": "docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.test.yml ps",
        "test": "python scripts/run_tests.py",
        "test:unit": "vitest run --config tests/vitest.config.ts",
        "test:e2e": "npx playwright test --config tests/playwright.config.ts",
        "test:e2e:ui": "npx playwright test --config tests/playwright.config.ts --ui",
        "session:start": "cd session-server && npm install && npm start",
        "docs:build": "pwsh -Command \"$env:NO_MKDOCS_2_WARNING='true'; python -m mkdocs build\"",
        "docs:serve": "pwsh -Command \"$env:NO_MKDOCS_2_WARNING='true'; python -m mkdocs serve\""
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": "eslint --config ./ui/eslint.config.mts",
        "*.{json,css,md}": "prettier"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@hebcal/core": "^6.9.2",
        "@mui/icons-material": "^7.3.5",
        "@mui/material": "^7.3.6",
        "@mui/material-nextjs": "^7.3.10",
        "@mui/stylis-plugin-rtl": "^7.3.6",
        "@mui/x-charts": "^9.10.1",
        "@mui/x-date-pickers": "^9.10.1",
        "@opentelemetry/api-logs": "^0.221.0",
        "@popperjs/core": "^2.11.8",
        "@system-b90/command-palette": "^0.1.0",
        "@system-b90/hive-core": "^0.3.0",
        "@system-b90/hive-nextauth": "^0.1.3",
        "@system-b90/session-ws": "^0.7.0",
        "@types/qrcode": "^1.5.6",
        "@uidotdev/usehooks": "^2.4.1",
        "@vercel/otel": "^2.1.3",
        "dayjs": "^1.11.21",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "exceljs": "^4.4.0",
        "googleapis": "^173.0.0",
        "lightningcss": "^1.33.0",
        "moment-timezone": "^0.5.48",
        "mongodb": "^7.5.0",
        "mui-color-input": "^7.0.0",
        "next": "^16.3.4",
        "next-auth": "^4.24.15",
        "next-themes": "^0.4.6",
        "notistack": "^3.0.2",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "pocketbase": "^0.27.0",
        "postgres": "^3.4.9",
        "qrcode": "^1.5.4",
        "react": "^19.2.8",
        "react-big-calendar": "^1.20.0",
        "react-dom": "^19.2.8",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "rimraf": "^6.1.3",
        "sass": "^1.102.0",
        "stylis": "4.2.0",
        "stylis-plugin-rtl": "^2.1.1",
        "tsx": "^4.23.1",
        "uuid": "^14.0.1",
        "ws": "^8.21.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@playwright/test": "^1.62.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@system-b90/test-kit": "^0.1.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.0",
        "@types/react": "^19.2.17",
        "@types/react-big-calendar": "^1.16.3",
        "@types/react-dom": "^19.2.2",
        "@types/stylis": "^4.2.7",
        "@types/ws": "^8.18.1",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.2.12",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-mui": "^0.1.1",
        "eslint-plugin-perfectionist": "^5.10.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unicorn": "^64.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.8.0",
        "husky": "^9.0.0",
        "jsdom": "^27.4.0",
        "prettier": "3.9.6",
        "tailwindcss": "^4.1.17",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.12.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    },
    "allowScripts": {
        "esbuild@0.27.7": true
    },
    "overrides": {
        "uuid": "^14.0.1",
        "stylis": "4.2.0",
        "gaxios": "^7.3.0",
        "@system-b90/hive-core": "^0.3.0",
        "glob": "^13.0.6"
    }
}
