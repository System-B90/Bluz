{
  "name": "bluz",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev ui --turbopack",
    "build": "next build ui",
    "start": "next start ui",
    "lint": "eslint --config ./ui/eslint.config.mts ui/",
    "lint:fix": "eslint --config ./ui/eslint.config.mts --fix",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate --config=drizzle/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle/drizzle.config.ts",
    "db:seed": "python scripts/demo/populate_demo_hive.py && npx tsx scripts/demo/populate_demo_bluz.ts",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d && docker compose -f docker-compose.yml -f docker-compose.dev.yml watch ui",
    "docker:prod": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:nuke": "docker compose down -- -v",
    "docker:test": "docker compose -f docker-compose.yml -f docker-compose.test.yml up -d --build",
    "docker:test:down": "docker compose -f docker-compose.yml -f docker-compose.test.yml down -v",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --config ./ui/eslint.config.mts",
    "*.{json,css,md}": "prettier"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.6",
    "@mui/material-nextjs": "^7.3.5",
    "@mui/stylis-plugin-rtl": "^7.3.6",
    "@mui/x-charts": "^9.0.1",
    "@mui/x-date-pickers": "^8.17.0",
    "@opentelemetry/api-logs": "^0.208.0",
    "@popperjs/core": "^2.11.8",
    "@svar-ui/react-gantt": "^2.6.1",
    "@uidotdev/usehooks": "^2.4.1",
    "@vercel/otel": "^2.1.0",
    "dayjs": "^1.11.19",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "lightningcss": "^1.30.2",
    "lucide-react": "^0.553.0",
    "mongodb": "^7.0.0",
    "mui-color-input": "^7.0.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "notistack": "^3.0.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pocketbase": "^0.26.8",
    "postgres": "^3.4.9",
    "react": "^19.2.3",
    "react-big-calendar": "^1.19.4",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.0",
    "rimraf": "^6.1.0",
    "sass": "^1.93.3",
    "stylis": "^4.3.6",
    "stylis-plugin-rtl": "^2.1.1",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.13.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.2.2",
    "@types/stylis": "^4.2.7",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mui": "^0.1.1",
    "eslint-plugin-perfectionist": "^5.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.0.0",
    "husky": "^9.0.0",
    "prettier": "3.8.3",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
